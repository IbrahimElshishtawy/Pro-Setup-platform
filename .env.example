# ==============================================================================
# PRO SETUP PLATFORM - FIREBASE & APP ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your project credentials
# Note: The platform features an intelligent hybrid engine that functions seamlessly
# both in offline/demo mode and with live Firebase Cloud Firestore!
# ==============================================================================

VITE_APP_NAME="PRO SETUP"
VITE_APP_URL="https://prosetup-platform.web.app"

# Firebase Client Configuration (Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="pro-setup-platform"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Business & Contact Integrations
VITE_CONTACT_WHATSAPP="+201234567890"
VITE_CONTACT_EMAIL="info@prosetup.com"
