# ==============================================================================
# Kitchen Pro — Environment Configuration Template
# Copy to .env.local for local development. Never commit .env.local or secrets.
# ==============================================================================

# Business Contact Details (Safe public client values)
VITE_CONTACT_WHATSAPP="201000000000"
VITE_CONTACT_EMAIL="info@kitchenpro.eg"
VITE_OFFICE_LOCATION="القاهرة الجديدة، مصر"

# Optional: Firebase Web App Config (Only required if connecting the contact form to Firestore)
# Leave empty to run the site purely as a fast static showcase with local form confirmation.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
