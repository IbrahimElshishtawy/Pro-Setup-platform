rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inquiries from Contact Form
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.name is string
                    && request.resource.data.message is string;
      allow read, update, delete: if request.auth != null; // Admin only
    }

    // Project Quote Requests
    match /quotes/{quoteId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.name is string;
      allow read, update, delete: if request.auth != null; // Admin only
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // ProSetup Academy Registrations
    match /academy_registrations/{registrationId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.courseSlug is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
